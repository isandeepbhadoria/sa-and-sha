# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Razorpay Configuration
VITE_RAZORPAY_KEY_ID=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# MSG91 Mobile/Email OTP widget only — NOT used for WhatsApp messaging
# (see Meta WhatsApp Cloud API config below).
MSG91_AUTH_KEY=
PUBLIC_BASE_URL=https://www.sa-and-sha.com
APP_BASE_URL=https://www.sa-and-sha.com
VITE_MSG91_WIDGET_ID=
VITE_MSG91_TOKEN_AUTH=
CUSTOMER_VERIFICATION_TOKEN_SECRET=

# Meta WhatsApp Cloud API — order/payment/shipping notifications and
# customer replies. Both WHATSAPP_ACCESS_TOKEN and WHATSAPP_PHONE_NUMBER_ID
# are required for sending; unset falls back to WHATSAPP_MOCK_MODE if that's
# "true", else fails closed (logged, never blocks the action that
# triggered it).
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Optional overrides:
# WHATSAPP_API_VERSION=v21.0
# WHATSAPP_MOCK_MODE=false
#
# WhatsApp Business Account ID — only needed for the admin "verify approved
# templates" diagnostic (GET /api/admin/notifications/verify-templates).
WHATSAPP_BUSINESS_ACCOUNT_ID=
#
# Inbound webhook (POST /api/webhooks/whatsapp) — register this URL in Meta's
# WhatsApp Manager (Configuration -> Webhook), subscribed to the "messages"
# field. WHATSAPP_WEBHOOK_VERIFY_TOKEN is any string you choose here and
# enter there — Meta echoes it back during the one-time verification
# handshake. WHATSAPP_APP_SECRET (Meta App Dashboard -> App Settings ->
# Basic) is optional but recommended — enables payload signature
# verification.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Admin Google Authenticator TOTP Secret
ADMIN_TOTP_SECRET=

# Blue Dart Configuration (Server-side only) — see src/server/bluedartClient.ts
# for the full field-by-field explanation, and DEPLOYMENT.md's Blue Dart
# section for setup notes. Powers pincode serviceability, forward AWB
# generation/dispatch, live tracking, AND automated reverse-pickup booking
# for customer returns — same credentials/profile/warehouse-origin config
# serves all of these; nothing extra is needed for reverse pickups.
BLUEDART_ENV=sandbox
BLUEDART_CLIENT_ID=
BLUEDART_CLIENT_SECRET=
BLUEDART_LOGIN_ID=
BLUEDART_LICENSE_KEY=
BLUEDART_API_TYPE=S
BLUEDART_API_VERSION=1.10
BLUEDART_ORIGIN_AREA=
BLUEDART_CUSTOMER_CODE=
BLUEDART_ORIGIN_NAME=
BLUEDART_ORIGIN_ADDRESS1=
BLUEDART_ORIGIN_ADDRESS2=
BLUEDART_ORIGIN_PINCODE=
BLUEDART_ORIGIN_PHONE=

# SMTP Transactional Email Configuration (Server-side only) — e.g. a
# mailbox on your own domain via Hostinger Email, Google Workspace, Zoho
# Mail, etc.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=orders@sa-and-sha.com
SMTP_FROM_NAME=Sa and Sha

# Firebase Client SDK Configuration (used by the browser bundle)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Only set if your Firestore uses a named database instead of "(default)"
VITE_FIREBASE_DATABASE_ID=

# Firebase Admin SDK Configuration (Server-side only)
FIREBASE_ADMIN_SERVICE_ACCOUNT_BASE64=
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=
# Only set if your Firestore uses a named database instead of "(default)"
FIREBASE_ADMIN_DATABASE_ID=

# Server-side Secret for Hashing Tracking OTPs & Verification Session Tokens
TRACKING_OTP_SECRET=

# GSTINAPI Configuration (Server-side only)
GSTIN_API_KEY=

# Internal Cron Endpoint Secret for Loyalty Pending Points Release
LOYALTY_CRON_SECRET=

# Google Analytics 4 & Meta Pixel — ad performance measurement and
# cart-abandonment retargeting. These scripts are gated by the cookie
# consent banner (src/context/CookieConsentContext.tsx): they only load in
# the visitor's browser after they accept Analytics/Marketing cookies, so
# leaving these unset simply means tracking never loads (fails closed).
VITE_GA4_MEASUREMENT_ID=
VITE_META_PIXEL_ID=



