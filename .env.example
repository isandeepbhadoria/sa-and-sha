# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Razorpay Configuration
VITE_RAZORPAY_KEY_ID=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# MSG91 Mobile OTP & WhatsApp Configuration
MSG91_AUTH_KEY=
MSG91_WHATSAPP_NUMBER=
MSG91_WHATSAPP_NAMESPACE=
MSG91_BASE_URL=https://control.msg91.com/api/v5/whatsapp/whatsapp-outbound-message/bulk/
PUBLIC_BASE_URL=https://www.sa-and-sha.com
APP_BASE_URL=https://www.sa-and-sha.com
VITE_MSG91_WIDGET_ID=
VITE_MSG91_TOKEN_AUTH=
CUSTOMER_VERIFICATION_TOKEN_SECRET=

# Admin Google Authenticator TOTP Secret
ADMIN_TOTP_SECRET=

# SMTP Transactional Email Configuration (Server-side only) — e.g. a
# mailbox on your own domain via Hostinger Email, Google Workspace, Zoho
# Mail, etc.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=orders@sa-and-sha.com
SMTP_FROM_NAME=Sa and Sha

# Firebase Client SDK Configuration (used by the browser bundle)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Only set if your Firestore uses a named database instead of "(default)"
VITE_FIREBASE_DATABASE_ID=

# Firebase Admin SDK Configuration (Server-side only)
FIREBASE_ADMIN_SERVICE_ACCOUNT_BASE64=
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=
# Only set if your Firestore uses a named database instead of "(default)"
FIREBASE_ADMIN_DATABASE_ID=

# Server-side Secret for Hashing Tracking OTPs & Verification Session Tokens
TRACKING_OTP_SECRET=

# GSTINAPI Configuration (Server-side only)
GSTIN_API_KEY=

# Internal Cron Endpoint Secret for Loyalty Pending Points Release
LOYALTY_CRON_SECRET=



